{
  "_comment": "Copy to config/vrusha.json to override the defaults in vrusha/config.py. Everything here is optional; the file is merged over the defaults.",
  "paths": {
    "root": "data"
  },
  "http": {
    "timeout": 20.0,
    "max_bytes": 3000000,
    "rate_per_host": 1.0,
    "respect_robots": true
  },
  "harvest": {
    "max_pages": 40,
    "max_depth": 2,
    "same_domain": true,
    "min_words": 120,
    "backend": "auto"
  },
  "store": {
    "embed_backend": "hash",
    "embed_dim": 256,
    "max_chunk_lines": 60,
    "max_chunk_chars": 4000
  },
  "address": {
    "weights": [
      8.0,
      4.0,
      2.0,
      1.0,
      0.5
    ],
    "segments": 5
  },
  "passes": {
    "near_duplicate_threshold": 0.97,
    "stale_days": 180,
    "cluster_max": 24,
    "graph_neighbours": 5,
    "seed": 1234
  },
  "query": {
    "top_k": 8,
    "candidates": 60,
    "fusion": {
      "bm25": 1.0,
      "vector": 1.0,
      "address": 0.35
    },
    "min_vector_similarity": 0.05,
    "refuse_below": 0.02
  },
  "tokens": {
    "vocab_size": 8192,
    "min_frequency": 2,
    "shard_tokens": 2000000,
    "val_fraction": 0.02
  },
  "train": {
    "preset": "tiny",
    "batch_size": 8,
    "seq_len": 256,
    "steps": 200,
    "lr": 0.0003
  }
}